{
    "name": "php-baremetal/ext-led",
    "description": "Baremetal\\Led\\Device and the addressable-LED driver framework. Chips are packages registering into the led_drivers registry; the platform side is a ledstrip-hal package.",
    "type": "bm-ext",
    "license": "MIT",
    "authors": [
        {
            "name": "Gianfrancesco Aurecchia",
            "email": "gianfri@aurecchia.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "php-baremetal/ledstrip-hal": "^1.0"
    },
    "extra": {
        "baremetal": {
            "module": "led",
            "priority": 100,
            "registries": {
                "led_drivers": {
                    "type": "led_driver_desc_t",
                    "header": "led_driver_desc.h"
                }
            }
        }
    }
}
